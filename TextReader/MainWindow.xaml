<Window x:Class="TextReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextReader"
        Title="Text Reader App" Height="600" Width="800"
        Closing="MainWindow_CleanTempFiles"
        PreviewKeyDown="MainWindow_KeybindAction">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Margin="10">

            <Button x:Name="BtnLoadFile"
                Content="Load File"
                Width="80"
                Margin="0,0,10,0"
                Command="{Binding OpenFileCommand}" />

            <Label Content="URL:"/>

            <TextBox Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     Margin="5,0,0,0"
                     VerticalContentAlignment="Center"/>

            <Button Content="Open URL"
                    Width="80"
                    Margin="5,0,0,0"
                    Command="{Binding OpenUrlCommand}" />

            <Button Content="Random"
                    Width="80"
                    Margin="5,0,0,0"
                    Command="{Binding GenerateRandomCommand}" />

            <Button Content="Save As"
                    Width="80"
                    Margin="5,0,0,0"
                    Command="{Binding SaveAsCommand}" />

        </StackPanel>

        <Grid Grid.Row="1"
                Margin="10"
                Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" >
                <Button Name="SearchBtn"
                        Content="Search"
                        Width="80"
                        Command="{Binding SearchCommand}"/>

                <Button Content="Previous"
                        Width="80"
                        Margin="5,0,0,0"
                        Command="{Binding FindPreviousCommand}"/>

                <Button Content="Next"
                        Width="80"
                        Margin="5,0,0,0"
                        Command="{Binding FindNextCommand}"/>
                
                <TextBox Name="SearchTxtBox"
                        Width="300"
                        Margin="10,0,0,0"
                        KeyDown="SearchTxtBox_KeyDown"
                        Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"/>

            </StackPanel>
            
        </Grid>

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="TextScrollViewer"
                          Grid.Column="0"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          Focusable="True"
                          Background="LightGray">

                <TextBlock Name="MainTextBlock"
                           Text="{Binding DisplayText}"
                           Width="{Binding ElementName=TextScrollViewer, Path=ActualWidth}"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextWrapping="NoWrap"
                           Padding="4"
                           />
            </ScrollViewer>

            <ScrollBar Grid.Column="1"
                       Orientation="Vertical"
                       Minimum="0"
                       IsEnabled="{Binding IsIndexReady}"
                       Maximum="{Binding MaxStartLine}"
                       Value="{Binding ScrollBarPosition, Mode=TwoWay}"
                       ValueChanged="DocumentScrollBar_ValueChanged"
                       SmallChange="1"
                       LargeChange="100"/>
        </Grid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Right"
                   Margin="10,0,10,8"/>
    </Grid>
</Window>
